# Copy this file to ".env" and fill in your own values. Never commit the real .env file.
GEMINI_API_KEY=your_gemini_api_key_here

# Model is configurable here or in the app sidebar.
GEMINI_MODEL=gemini-2.5-flash

# SQLite database location (created automatically).
DB_PATH=data/career_app.db
# Set only for cloud PostgreSQL, otherwise use local SQLite.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
# APP_ENV=production requires a PostgreSQL DATABASE_URL.
# AI_DAILY_USER_LIMIT=40
# AI_DAILY_GLOBAL_LIMIT=300
